# Solutions Numbers — пример настроек.
# Скопируйте в .env рядом с main.py и заполните. Пустое значение = значение по умолчанию.
# Почти всё ниже «Цен» можно потом менять из /admin → Настройки без перезапуска.

# ══ Telegram ═══════════════════════════════════════════════════════════
# Токен бота из @BotFather
BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExam
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789
# Публичный https-адрес этого сервера — по нему открывается Mini App.
# Пусто — бот работает только в текстовом режиме (кнопками в чате)
WEBAPP_URL=https://numbers.example.com
PORT=8090
# Название магазина в счетах и админке
BRAND=Solutions Numbers
# Поддержка: @ник или ссылка
SUPPORT=@your_support

# ══ Канал и обязательная подписка ══════════════════════════════════════
# Бот должен быть АДМИНОМ этого канала, иначе он не видит подписчиков
CHANNEL=@your_channel
# Ссылка на канал (если пусто — https://t.me/<CHANNEL>)
CHANNEL_URL=
# 1 — без подписки на CHANNEL бот и Mini App не работают
SUB_REQUIRED=1

# ══ Премиум-эмодзи ═════════════════════════════════════════════════════
# Пак премиум-эмодзи (t.me/addemoji/<имя>). Обычных эмодзи в боте нет.
# Для иконок на кнопках у владельца бота нужен Telegram Premium
EMOJI_PACK=tgiosicons

# ══ LZT Market ═════════════════════════════════════════════════════════
# Токен API с доступом market: lzt.market → настройки → API.
# Пусто — ДЕМО-режим: выдуманные лоты, покупки без денег
LZT_TOKEN=
LZT_BASE=https://api.lzt.market
# 1 — принудительно демо даже с токеном (для проверки)
LZT_DEMO=0
# Какие аккаунты продаём (stealer/phishing/brute — никогда)
LZT_ORIGINS=autoreg,self_registration,personal,resale
# 1 — только без спамблока
LZT_NO_SPAM=1
# Дороже этой цены (₽) лоты не продаём
LZT_MAX_PRICE=3000
# Продавцы: минимум продаж и максимум % восстановленных (отобранных обратно) аккаунтов
SELLER_MIN_SOLD=50
SELLER_MAX_RESTORE=10
# Чёрный список продавцов (ник или ID через запятую)
SELLER_BLACKLIST=AccPoint
# После стольких подтверждённых «не работает» продавец попадает в чёрный список сам
SELLER_STRIKES=3
# Сколько секунд держать выдачу маркета в кэше
CACHE_TTL=90
# Витрина: бот обходит общий каталог LZT и раскладывает лоты по странам у себя.
# Дешёвых страниц + новых страниц за обход (~40 лотов на странице) и пауза между обходами
CRAWL_CHEAP_PAGES=30
CRAWL_NEW_PAGES=30
CRAWL_EVERY=180

# ══ Цены ═══════════════════════════════════════════════════════════════
# Наценка к цене LZT: 0.10 = +10 %
MARKUP=0.10
# Но не меньше стольких рублей с аккаунта
MIN_MARGIN_RUB=2
# Номинал звезды в рублях и множитель для оплаты звёздами (×2 = +100 %)
STAR_RUB=1.4
STARS_MARKUP=2.0

# ══ Лимит покупок ══════════════════════════════════════════════════════
# Аккаунтов в сутки на человека. 0 — без лимита
MAX_PER_DAY=0
# Для тех, кто пришёл меньше суток назад. 0 — без лимита
MAX_PER_DAY_NEW=0

# ══ Резерв мгновенной выдачи ═══════════════════════════════════════════
# Сколько аккаунтов держать купленными заранее (0 — выключить)
RESERVE_SIZE=10
# Для каких стран (ISO-3 через запятую): RUS,USA,KAZ
RESERVE_COUNTRIES=RUS
# Не дороже стольких ₽ за аккаунт в резерв
RESERVE_MAX_PRICE=40
# Как часто перепроверять резерв через гарантию LZT, минут
RESERVE_CHECK_MIN=30
RESERVE_MAX_AGE_H=20

# ══ Гарантия ═══════════════════════════════════════════════════════════
# Сколько часов после выдачи работает кнопка «Аккаунт не работает»
GUARANTEE_H=24

# ══ Конкурс дня ════════════════════════════════════════════════════════
GIVEAWAY_ON=1
# Час розыгрыша по Москве
GIVEAWAY_HOUR=20
# Приз — аккаунт не дороже стольких ₽ (и только если маржа за сутки его покрывает)
GIVEAWAY_MAX_PRICE=15
# 1 — рассылать итоги всем
GIVEAWAY_BROADCAST=1

# ══ Рефералы ═══════════════════════════════════════════════════════════
# Сколько друзей за один бесплатный аккаунт
REF_GOAL=15
# Приз — аккаунт не дороже стольких ₽
REF_PRIZE_MAX=15
# Не больше стольких реферальных призов в сутки на всех
REF_DAILY_MAX=20

# ══ Оплата ═════════════════════════════════════════════════════════════
# CryptoBot (@send): Crypto Pay → Create App → API Token
CRYPTOBOT_TOKEN=
CRYPTOBOT_ASSET=USDT
# 1 — тестовая сеть @CryptoTestnetBot
CRYPTOBOT_TESTNET=0

# xRocket (@xrocket): Rocket Pay → API key
XROCKET_TOKEN=
XROCKET_ASSET=USDT
XROCKET_TESTNET=0

# Прямой перевод TON на ваш Tonkeeper (адрес кошелька)
TON_WALLET=
# Ключ toncenter.com — не обязателен, но снимает лимиты запросов
TONCENTER_KEY=
TONCENTER_URL=https://toncenter.com/api/v3
TONAPI_URL=https://tonapi.io

# Telegram Stars
STARS_ON=1

# Минимальное пополнение, ₽
TOPUP_MIN=30
# Сколько минут живёт счёт
INVOICE_TTL_MIN=30
# Резервные курсы, если биржи не ответили (₽ за 1 USDT / 1 TON)
USDT_RUB=95
TON_RUB=300
# Допуск по сумме перевода TON (0.98 = можно недослать 2 %)
PAY_TOLERANCE=0.98
# Как часто проверять оплаты, секунд
POLL_INTERVAL=30

# ══ Служебное ══════════════════════════════════════════════════════════
# Файл базы (по умолчанию data/shop.db)
DB_PATH=data/shop.db
# 1 — вход без Telegram по http://localhost:8090/?dev=1 — ТОЛЬКО для локальной проверки.
# При заданном https WEBAPP_URL игнорируется автоматически
DEV_AUTH=0
