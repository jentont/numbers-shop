# ── Telegram ──
BOT_TOKEN=
ADMIN_IDS=123456789                           # ваш Telegram ID (через запятую, если несколько)
WEBAPP_URL=https://your-domain.example      # https-адрес этого сервера (Mini App)
PORT=8090
SUPPORT=@your_support
CHANNEL=@your_channel                         # бот должен быть админом канала
SUB_REQUIRED=1                                # без подписки на CHANNEL бот и Mini App не работают
EMOJI_PACK=tgiosicons                         # пак премиум-эмодзи (обычных эмодзи в боте нет)
BRAND=Solutions Numbers
DEV_AUTH=0                                    # 1 — вход без Telegram по ?dev=1, только для проверки!

# ── LZT Market ──
LZT_TOKEN=                                    # токен с доступом market; пусто = демо-режим
LZT_ORIGINS=autoreg,self_registration,personal,resale
LZT_NO_SPAM=1
LZT_MAX_PRICE=3000

# ── Цены ──
MARKUP=0.10                                   # +10 % к цене LZT
MIN_MARGIN_RUB=2                              # минимум 2 ₽ с аккаунта
STAR_RUB=1.4
STARS_MARKUP=2.0                              # в звёздах ×2

# ── Резерв мгновенной выдачи ──
RESERVE_SIZE=10
RESERVE_COUNTRIES=RUS
RESERVE_MAX_PRICE=40

# ── Конкурс ──
GIVEAWAY_ON=1
GIVEAWAY_HOUR=20                              # МСК
GIVEAWAY_MAX_PRICE=15
GIVEAWAY_BROADCAST=1

# ── Оплата ──
CRYPTOBOT_TOKEN=                              # @send → Crypto Pay → токен приложения
CRYPTOBOT_ASSET=USDT
XROCKET_TOKEN=
XROCKET_ASSET=USDT
TON_WALLET=                                   # адрес Tonkeeper
TONCENTER_KEY=
STARS_ON=1
TOPUP_MIN=30
